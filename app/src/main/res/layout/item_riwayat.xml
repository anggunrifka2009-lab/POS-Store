<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    android:backgroundTint="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_printer"
            android:padding="10dp"
            android:background="@drawable/bg_circle_brown_light"
            app:tint="#4E342E" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvIdTransaksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#TRX-001"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?attr/color"/>

            <TextView
                android:id="@+id/tvWaktu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12-05-2024 | 14:00"
                android:textSize="12sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/tvKasir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kasir: Anggun"
                android:textSize="12sp"
                android:textColor="#757575" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTotalRiwayat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 50.000"
            android:textStyle="bold"
            android:textColor="?attr/colorAccent"
            android:textSize="16sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
